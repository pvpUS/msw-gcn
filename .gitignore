# gxtexconv intermediates: the build_*.py tools write the .png, gxtexconv turns
# it into the committed .tpl and drops an unused .h beside it
data/atlas.png
data/atlas.h
data/font.png
data/font.h
data/steve.png
data/steve.h
data/dragon.png
data/dragon.h

# proxy
proxy/node_modules/
# the Microsoft account name and anything else machine-specific, shallow-merged
# over the committed config.json
proxy/config.local.json
# cached auth tokens -- these are credentials
proxy/.mcauth/
# --record captures: large, and they contain a real game's chat
*.gcr
